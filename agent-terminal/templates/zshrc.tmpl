# Notifications for long-running commands (works in zellij as it's shell-level).
bgnotify_threshold=10
bgnotify_bell=true
typeset -ga bgnotify_ignore_cmd_prefixes=(ls ll la l cd pwd clear history jobs fg bg exit)

function _notify_send() {
  emulate -L zsh
  local title="${1:-Notification}"
  local message="${2:-Task finished}"
  local term_program="${TERM_PROGRAM:-}"

  # sanitize control chars/newlines for escape sequence
  message="${message//$'\n'/ }"
  message="${message//$'\a'/ }"

  # Prefer iTerm2 native notifications via OSC 9.
  if [[ "$term_program" == "iTerm.app" ]]; then
    print -n -- $'\e]9;'"${title}: ${message}"$'\a'
    return 0
  fi

  # Fallback 1: terminal-notifier
  if (( ${+commands[terminal-notifier]} )); then
    terminal-notifier -title "$title" -message "$message" -activate com.googlecode.iterm2 >/dev/null 2>&1 &!
    return 0
  fi

  # Fallback 2: osascript (if available in this environment)
  if (( ${+commands[osascript]} )); then
    osascript -e "display notification \"${message}\" with title \"${title}\"" >/dev/null 2>&1 &!
    return 0
  fi
}

function bgnotify_formatted {
  # $1=exit_status, $2=command, $3=elapsed_seconds
  local exit_status=$1
  local cmd="$2"
  local elapsed_sec=$3
  local cmd_head="${${cmd%% *}:l}"

  # Skip noisy trivial commands.
  local p
  for p in "${bgnotify_ignore_cmd_prefixes[@]}"; do
    [[ "$cmd_head" == "$p" ]] && return 0
  done

  local elapsed="$(( elapsed_sec % 60 ))s"
  (( elapsed_sec < 60 )) || elapsed="$((( elapsed_sec % 3600) / 60 ))m $elapsed"
  (( elapsed_sec < 3600 )) || elapsed="$(( elapsed_sec / 3600 ))h $elapsed"

  local title
  if [[ $exit_status -eq 0 ]]; then
    title="Command finished (${elapsed})"
  else
    title="Command failed (${elapsed}, code=${exit_status})"
  fi

  [[ $bgnotify_bell == true ]] && printf '\a'
  [[ -n "$ZELLIJ" ]] && title="[zellij] ${title}"
  _notify_send "$title" "$cmd"
}

# Override bgnotify default behavior: notify even when terminal is frontmost.
function bgnotify_end {
  {
    local exit_status=$?
    local elapsed=$(( EPOCHSECONDS - bgnotify_timestamp ))
    [[ $bgnotify_timestamp -gt 0 ]] || return 0
    [[ $elapsed -ge $bgnotify_threshold ]] || return 0
    bgnotify_formatted "$exit_status" "$bgnotify_lastcmd" "$elapsed"
  } always {
    bgnotify_timestamp=0
  }
}

