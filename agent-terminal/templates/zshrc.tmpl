# Notify when sudo is likely waiting for your password input.
function sudo() {
  emulate -L zsh
  local need_prompt=true
  local arg
  for arg in "$@"; do
    case "$arg" in
      -n|--non-interactive) need_prompt=false ;;
      --) break ;;
    esac
  done

  if [[ "$need_prompt" == true ]] && ! command sudo -n true 2>/dev/null; then
    [[ $bgnotify_bell == true ]] && printf '\a'
    _notify_send "Input required" "sudo is waiting for your password: ${*:-sudo}"
  fi
  command sudo "$@"
}

# Manual helper for any command/script that may block waiting for input.
function notify_input() {
  local msg="${1:-Terminal is waiting for your input}"
  [[ $bgnotify_bell == true ]] && printf '\a'
  _notify_send "Input required" "$msg"
}

