{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Manager",
  "version": "0.1.0",
  "identifier": "io.github.ly87ing.agent-manager",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agent Manager",
        "width": 1000,
        "height": 650,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["agentmanager"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/ly87ing/agent-manager/releases/latest/download/latest.json"
      ],
      "pubkey": "YOUR_UPDATER_PUBKEY"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "shortDescription": "集中管理 AI 编程助手的桌面工具",
    "longDescription": "Agent Manager 集中管理 Claude Code、Codex、OpenCode 等 AI 编程助手的安装、Skills、MCP 服务器、规则、Hooks 与 Shell 别名。",
    "copyright": "Copyright (c) 2026 ly87ing",
    "publisher": "ly87ing",
    "category": "DeveloperTool",
    "homepage": "https://github.com/ly87ing/agent-manager",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": []
  }
}
