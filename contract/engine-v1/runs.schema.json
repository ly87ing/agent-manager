{
  "description": "Data payload shape of runs:list and runs:get. Both responses are read-only views over native-manager.db operation_logs.",
  "oneOf": [
    {
      "title": "runs:list",
      "type": "object",
      "required": ["runs"],
      "additionalProperties": false,
      "properties": {
        "runs": {
          "type": "array",
          "items": { "$ref": "#/$defs/run_summary" }
        }
      }
    },
    {
      "title": "runs:get",
      "type": "object",
      "required": ["run_id", "operations"],
      "additionalProperties": false,
      "properties": {
        "run_id": { "type": "string" },
        "operations": {
          "type": "array",
          "items": { "$ref": "#/$defs/operation" }
        }
      }
    }
  ],
  "$defs": {
    "run_summary": {
      "type": "object",
      "required": ["run_id", "operations", "last_at"],
      "additionalProperties": false,
      "properties": {
        "run_id": { "type": "string" },
        "operations": { "type": "integer", "minimum": 0 },
        "last_at": { "type": "string" }
      }
    },
    "operation": {
      "type": "object",
      "required": ["id", "operation_type", "target", "detail", "created_at"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "operation_type": { "type": "string" },
        "target": { "type": ["string", "null"] },
        "detail": {},
        "created_at": { "type": "string" }
      }
    }
  }
}
