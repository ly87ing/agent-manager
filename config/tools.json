{
  "tools": {
    "playwright-cli": {
      "install": "npm install -g @playwright/cli",
      "uninstall": "npm uninstall -g @playwright/cli",
      "upgrade": "npm install -g @playwright/cli",
      "setup": "playwright-cli install-browser",
      "setup_timeout_sec": 300,
      "ready_check": "bin:playwright-cli",
      "runtime_ready_globs_any": [
        "~/Library/Caches/ms-playwright/chromium-*",
        "~/Library/Caches/ms-playwright/chromium_headless_shell-*",
        "~/.cache/ms-playwright/chromium-*",
        "~/.cache/ms-playwright/chromium_headless_shell-*",
        "~/AppData/Local/ms-playwright/chromium-*",
        "~/AppData/Local/ms-playwright/chromium_headless_shell-*"
      ]
    }
  }
}
