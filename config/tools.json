{
  "tools": {
    "playwright-cli": {
      "url": "https://github.com/microsoft/playwright-cli.git",
      "setup": "npm install && npx playwright install",
      "ready_paths": ["node_modules"]
    },
    "auggie": {
      "install": "npm install -g @augmentcode/auggie"
    },
    "iterm2": {
      "install": "brew install --cask iterm2",
      "uninstall": "brew uninstall --cask iterm2",
      "upgrade": "brew upgrade --cask iterm2",
      "ready_check": "app:/Applications/iTerm.app"
    },
    "tmux": {
      "install": "brew install tmux",
      "uninstall": "brew uninstall tmux",
      "upgrade": "brew upgrade tmux",
      "ready_check": "bin:tmux"
    },
    "tpm": {
      "install": "git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm",
      "upgrade": "git -C ~/.tmux/plugins/tpm pull",
      "ready_check": "app:~/.tmux/plugins/tpm/bin/tpm"
    },
    "oh-my-zsh": {
      "install": "sh -c \"$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)\" \"\" --unattended",
      "upgrade": "git -C ~/.oh-my-zsh pull",
      "ready_check": "app:~/.oh-my-zsh"
    },
    "powerlevel10k": {
      "install": "brew install powerlevel10k",
      "uninstall": "brew uninstall powerlevel10k",
      "upgrade": "brew upgrade powerlevel10k",
      "ready_check": "app:/usr/local/share/powerlevel10k/powerlevel10k.zsh-theme"
    },
    "zsh-autosuggestions": {
      "install": "brew install zsh-autosuggestions",
      "uninstall": "brew uninstall zsh-autosuggestions",
      "upgrade": "brew upgrade zsh-autosuggestions",
      "ready_check": "app:/usr/local/opt/zsh-autosuggestions"
    },
    "zsh-syntax-highlighting": {
      "install": "brew install zsh-syntax-highlighting",
      "uninstall": "brew uninstall zsh-syntax-highlighting",
      "upgrade": "brew upgrade zsh-syntax-highlighting",
      "ready_check": "app:/usr/local/opt/zsh-syntax-highlighting"
    },
    "terminal-notifier": {
      "install": "brew install terminal-notifier",
      "uninstall": "brew uninstall terminal-notifier",
      "upgrade": "brew upgrade terminal-notifier",
      "ready_check": "bin:terminal-notifier"
    },
    "meslo-nerd-font": {
      "install": "brew install --cask font-meslo-lg-nerd-font",
      "uninstall": "brew uninstall --cask font-meslo-lg-nerd-font",
      "upgrade": "brew upgrade --cask font-meslo-lg-nerd-font",
      "ready_check": "app:~/Library/Fonts/MesloLGS NF Regular.ttf"
    }
  }
}
