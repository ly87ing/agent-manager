{
  "settings_path": "../.claude/settings.json",
  "removed_signatures": [
    {
      "event": "PreToolUse",
      "matcher": "Bash",
      "command_contains": "graphify-out/GRAPH_REPORT.md before searching raw files"
    }
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/agent-rule/hooks/graphify-context-hint.sh\""
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/agent-rule/hooks/block-dist-edits.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/agent-rule/hooks/check-rules-build.sh\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/agent-rule/hooks/check-rules-build.sh\""
          }
        ]
      }
    ]
  }
}
