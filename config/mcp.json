{
  "servers": {
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@1.2.0", "--isolated"],
      "startup_timeout_sec": 120,
      "env": {},
      "version_lock": {
        "type": "npm",
        "package": "chrome-devtools-mcp",
        "fields": {
          "args.1": "chrome-devtools-mcp@{version}"
        }
      },
      "agents": null
    },
    "grok-search": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/GuDaStudio/GrokSearch@8f0ae3c7f25ec419631ade7e431fa2531503433e",
        "grok-search"
      ],
      "startup_timeout_sec": 120,
      "env": {
        "GROK_API_URL": "${GROK_API_URL}",
        "GROK_API_KEY": "${GROK_API_KEY}",
        "GROK_MODEL": "${GROK_MODEL}",
        "TAVILY_ENABLED": "${TAVILY_ENABLED}",
        "TAVILY_API_KEY": "${TAVILY_API_KEY}",
        "TAVILY_API_URL": "${TAVILY_API_URL}",
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}",
        "FIRECRAWL_API_URL": "${FIRECRAWL_API_URL}"
      },
      "version_lock": {
        "type": "git-ref",
        "remote": "https://github.com/GuDaStudio/GrokSearch",
        "ref": "grok-with-tavily",
        "fields": {
          "args.1": "git+https://github.com/GuDaStudio/GrokSearch@{version}"
        }
      },
      "agents": null
    },
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena@dcbd8ce064fd057858ba49c9f74b433b95d9f17a",
        "serena",
        "start-mcp-server",
        "--context",
        "ide-assistant",
        "--open-web-dashboard",
        "false"
      ],
      "startup_timeout_sec": 120,
      "env": {},
      "project_serena_folder_location": "/tmp/serena$projectDir/.serena",
      "version_lock": {
        "type": "git-ref",
        "remote": "https://github.com/oraios/serena",
        "ref": "main",
        "fields": {
          "args.1": "git+https://github.com/oraios/serena@{version}"
        }
      },
      "agents": null
    }
  },
  "agent_paths": {
    "claude-code": "~/.claude.json",
    "antigravity-cli": "~/.gemini/config/mcp_config.json",
    "codex": { "path": "~/.codex/config.toml", "format": "toml" }
  }
}
