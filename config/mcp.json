{
  "servers": {
    "augment-context-engine": {
      "command": "auggie",
      "args": ["--mcp", "--mcp-auto-workspace"],
      "env": {
        "AUGMENT_SESSION_AUTH": "${AUGMENT_SESSION_AUTH}"
      },
      "agents": null
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest", "--isolated"],
      "env": {},
      "agents": null
    },
    "grok-search": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/GuDaStudio/GrokSearch@grok-with-tavily",
        "grok-search"
      ],
      "env": {
        "GROK_API_URL": "${GROK_API_URL}",
        "GROK_API_KEY": "${GROK_API_KEY}"
      },
      "agents": null
    }
  },
  "agent_paths": {
    "claude-code": "~/.claude.json",
    "gemini-cli": "~/.gemini/settings.json",
    "cursor": "~/.cursor/mcp.json",
    "opencode": { "path": "~/.config/opencode/opencode.json", "format": "json" },
    "codex": { "path": "~/.codex/config.toml", "format": "toml" },
    "kimi-cli": { "path": "~/.kimi/mcp.json", "format": "json" }
  }
}
