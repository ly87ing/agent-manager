{
  "servers": {
    "chrome-devtools": {
      "command": "chrome-devtools-mcp",
      "args": ["--isolated", "--no-usage-statistics"],
      "startup_timeout_sec": 120,
      "env": {},
      "agents": null
    },
    "grok-search": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/GuDaStudio/GrokSearch@grok-with-tavily",
        "grok-search"
      ],
      "startup_timeout_sec": 120,
      "env": {
        "GROK_API_URL": "${GROK_API_URL}",
        "GROK_API_KEY": "${GROK_API_KEY}",
        "GROK_MODEL": "${GROK_MODEL}",
        "TAVILY_ENABLED": "${TAVILY_ENABLED}",
        "TAVILY_API_KEY": "${TAVILY_API_KEY}",
        "TAVILY_API_URL": "${TAVILY_API_URL}",
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}",
        "FIRECRAWL_API_URL": "${FIRECRAWL_API_URL}"
      },
      "agents": null
    },
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena@main",
        "serena",
        "start-mcp-server",
        "--open-web-dashboard",
        "false"
      ],
      "extra_args_by_agent": {
        "claude-code": [
          "--context",
          "claude-code",
          "--project-from-cwd"
        ],
        "codex": [
          "--context",
          "codex",
          "--project-from-cwd"
        ]
      },
      "startup_timeout_sec": 120,
      "env": {},
      "project_serena_folder_location": "/tmp/serena$projectDir/.serena",
      "agents": null
    }
  },
  "agent_paths": {
    "claude-code": "~/.claude.json",
    "codex": { "path": "~/.codex/config.toml", "format": "toml" },
    "kimi-code": "~/.kimi-code/mcp.json"
  }
}
