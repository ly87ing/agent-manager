{
  "targets": {
    "tmux": {
      "requires": ["tmux"],
      "template": "agent-terminal/templates/tmux.conf.tmpl",
      "destination": "~/.tmux.conf",
      "chmod": "0600"
    },
    "zshrc": {
      "template": "agent-terminal/templates/zshrc.tmpl",
      "destination": "~/.zshrc",
      "chmod": "0600"
    },
    "iterm2_dynamic_profile": {
      "requires": ["iterm2"],
      "template": "agent-terminal/templates/iterm2-profile.json.tmpl",
      "destination": "~/Library/Application Support/iTerm2/DynamicProfiles/managed.json",
      "chmod": "0600",
      "iterm2_preset": "TokyoNight Storm"
    },
    "ccstatusline_settings": {
      "requires": ["ccstatusline"],
      "template": "agent-terminal/templates/ccstatusline-settings.json.tmpl",
      "destination": "~/.config/ccstatusline/settings.json",
      "chmod": "0644"
    }
  },
  "secrets_file": "secrets/terminal.env"
}
