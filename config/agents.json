{
  "claude-code": {
    "display_name": "Claude Code",
    "bin": "claude",
    "preferred_provider": "npm",
    "require_managed_provider": true,
    "providers": {
      "native": {
        "managed": true,
        "install": {
          "darwin": "curl -fsSL https://claude.ai/install.sh | bash",
          "linux": "curl -fsSL https://claude.ai/install.sh | bash",
          "windows": "curl -fsSL https://claude.ai/install.cmd -o install.cmd && install.cmd && del install.cmd"
        },
        "uninstall": {
          "posix": "rm -f ~/.local/bin/claude && rm -rf ~/.local/share/claude",
          "windows": "powershell -NoProfile -Command \"Remove-Item -Path \\\"$env:USERPROFILE\\\\.local\\\\bin\\\\claude.exe\\\" -Force; Remove-Item -Path \\\"$env:USERPROFILE\\\\.local\\\\share\\\\claude\\\" -Recurse -Force\""
        },
        "upgrade": "claude update",
        "detect_paths": ["~/.local/bin/claude"]
      },
      "npm": {
        "managed": true,
        "install": "npm install -g @anthropic-ai/claude-code@2.1.177",
        "uninstall": "npm uninstall -g @anthropic-ai/claude-code",
        "upgrade": "npm install -g @anthropic-ai/claude-code@2.1.177",
        "version_lock": {
          "type": "npm",
          "package": "@anthropic-ai/claude-code",
          "fields": {
            "install": "npm install -g @anthropic-ai/claude-code@{version}",
            "upgrade": "npm install -g @anthropic-ai/claude-code@{version}"
          }
        }
      },
      "brew": {
        "managed": false,
        "install": "brew install --cask claude-code",
        "uninstall": "brew uninstall --cask claude-code",
        "upgrade": "brew upgrade --cask claude-code"
      }
    }
  },
  "antigravity-cli": {
    "display_name": "Antigravity CLI",
    "bin": "agy",
    "preferred_provider": "native",
    "require_managed_provider": true,
    "providers": {
      "native": {
        "managed": true,
        "install": {
          "darwin": "curl -fsSL https://antigravity.google/cli/install.sh | bash",
          "linux": "curl -fsSL https://antigravity.google/cli/install.sh | bash",
          "windows": "curl -fsSL https://antigravity.google/cli/install.cmd -o install.cmd && install.cmd && del install.cmd"
        },
        "uninstall": {
          "posix": "rm -f ~/.local/bin/agy",
          "windows": "powershell -NoProfile -Command \"Remove-Item -Path \\\"$env:USERPROFILE\\\\AppData\\\\Local\\\\agy\\\\bin\\\\agy.exe\\\" -Force\""
        },
        "unsupported_actions": ["update"],
        "detect_paths": ["~/.local/bin/agy"]
      }
    }
  },
  "codex": {
    "display_name": "Codex",
    "bin": "codex",
    "preferred_provider": "npm",
    "require_managed_provider": true,
    "providers": {
      "npm": {
        "managed": true,
        "install": "npm install -g @openai/codex@0.139.0",
        "uninstall": "npm uninstall -g @openai/codex",
        "upgrade": "npm install -g @openai/codex@0.139.0",
        "version_lock": {
          "type": "npm",
          "package": "@openai/codex",
          "fields": {
            "install": "npm install -g @openai/codex@{version}",
            "upgrade": "npm install -g @openai/codex@{version}"
          }
        }
      },
      "brew": {
        "managed": false,
        "install": "brew install --cask codex"
      }
    }
  }
}
