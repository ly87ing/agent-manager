{
  "hooks_path": "../.codex/hooks.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd); bash \"$ROOT/agent-rule/hooks/graphify-context-hint.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd); HOOK=\"$ROOT/agent-rule/hooks/check-rules-build.sh\"; [ -x \"$HOOK\" ] && bash \"$HOOK\" || true"
          }
        ]
      }
    ]
  }
}
