{
  "binary": {
    "command": "herdr",
    "fallback_paths": [
      "~/.local/bin/herdr"
    ],
    "install": {
      "posix": "curl -fsSL https://herdr.dev/install.sh | sh",
      "windows": "powershell -ExecutionPolicy Bypass -c \"irm https://herdr.dev/install.ps1 | iex\""
    }
  },
  "integrations": {
    "claude-code": {
      "target": "claude",
      "agent_command": "claude"
    },
    "codex": {
      "target": "codex",
      "agent_command": "codex"
    }
  }
}
